# Puerto de escucha del servidor Express
PORT=5000

# Cadena de conexión a MongoDB Atlas o local
# Reemplazar <usuario> y <password> con tus credenciales de MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:password@cluster0.mongodb.net/muebleria_jota?retryWrites=true&w=majority

# URL permitida para peticiones CORS desde el Frontend (React)
FRONTEND_URL=http://localhost:5173

# Entorno de ejecución (development | production)
NODE_ENV=development
